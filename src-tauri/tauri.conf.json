{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Datum Plot",
  "identifier": "com.edgarmendonca.datumplot",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm run build:ui",
    "beforeDevCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Datum Plot",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Datum",
    "copyright": "© 2026 Edgar Mendonca",
    "category": "Education",
    "shortDescription": "Scientific graphs and statistics",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../py/worker.py": "py/worker.py",
      "../py/datum/*.py": "py/datum/"
    },
    "fileAssociations": [
      { "ext": ["dplot"], "name": "Datum Plot project", "description": "Datum Plot project", "role": "Editor" }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
